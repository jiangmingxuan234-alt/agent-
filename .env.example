# The workflow first checks these variables, then falls back to the existing
# ~/.codex/auth.json and ~/.codex/config.toml files. Never commit a real key.
AI_API_KEY=
AI_BASE_URL=https://your-openai-compatible-host.example/v1
# Global fallback. Each role can override this because relays often expose
# different protocols for GPT/Codex and Claude routes.
AI_API_MODE=auto
PLANNER_API_MODE=responses
DOCS_API_MODE=chat_completions
REVIEW_API_MODE=responses

PLANNER_MODEL=gpt-5.6-terra
CODE_MODEL=gpt-5.6-sol
CODE_REASONING_EFFORT=xhigh
DOCS_MODEL=claude-sonnet-4-6
REVIEW_MODEL=gpt-5.6-luna

MAX_RETRIES=2
CODEX_TIMEOUT_SECONDS=1800
TEST_TIMEOUT_SECONDS=900
